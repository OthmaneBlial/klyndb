+use super::{Postgres, err};
+use klyndb_driver_api::{
+    CatalogInspection, CatalogKind, CatalogObject, CatalogPage, Error, Result,
+};
+
+// All fragments are fixed native catalog expressions. Search is bound separately;
+// the only interpolated value is a parsed numeric OID.
+fn query_parts(
+    kind: CatalogKind,
+) -> (
+    &'static str,
+    &'static str,
+    &'static str,
+    &'static str,
+    &'static str,
+    &'static str,
+    &'static str,
+) {
+    match kind {
+        CatalogKind::Types => (
+            "pg_catalog.pg_type t JOIN pg_catalog.pg_namespace n ON n.oid=t.typnamespace LEFT JOIN pg_catalog.pg_class c ON c.oid=t.typrelid",
+            "t.oid",
+            "n.nspname",
+            "t.typname",
+            "CASE t.typtype WHEN 'd' THEN 'domain' WHEN 'e' THEN 'enum' WHEN 'c' THEN 'composite' WHEN 'r' THEN 'range' WHEN 'm' THEN 'multirange' ELSE 'base type' END",
+            "n.nspname NOT IN ('pg_catalog','information_schema') AND n.nspname NOT LIKE 'pg_toast%' AND t.typisdefined AND t.typcategory<>'A' AND (t.typtype<>'c' OR c.relkind='c') AND pg_catalog.has_schema_privilege(n.oid,'USAGE') AND pg_catalog.has_type_privilege(t.oid,'USAGE')",
+            r#"pg_catalog.jsonb_build_object(
+                'owner',pg_catalog.pg_get_userbyid(t.typowner),
+                'comment',pg_catalog.obj_description(t.oid,'pg_type'),
+                'base_type',CASE WHEN t.typbasetype<>0 THEN pg_catalog.format_type(t.typbasetype,t.typtypmod) END,
+                'not_null',t.typnotnull,'default',t.typdefault,
+                'enum_labels',(SELECT pg_catalog.jsonb_agg(e.enumlabel ORDER BY e.enumsortorder) FROM pg_catalog.pg_enum e WHERE e.enumtypid=t.oid),
+                'attributes',(SELECT pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('name',a.attname,'type',pg_catalog.format_type(a.atttypid,a.atttypmod)) ORDER BY a.attnum) FROM pg_catalog.pg_attribute a WHERE a.attrelid=t.typrelid AND a.attnum>0 AND NOT a.attisdropped),
+                'constraints',(SELECT pg_catalog.jsonb_agg(pg_catalog.pg_get_constraintdef(co.oid,true) ORDER BY co.conname) FROM pg_catalog.pg_constraint co WHERE co.contypid=t.oid),
+                'range_subtype',(SELECT pg_catalog.format_type(r.rngsubtype,NULL) FROM pg_catalog.pg_range r WHERE r.rngtypid=t.oid OR r.rngmultitypid=t.oid)
+            )"#,
+        ),
+        CatalogKind::Sequences => (
+            "pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace JOIN pg_catalog.pg_sequence s ON s.seqrelid=c.oid",
+            "c.oid",
+            "n.nspname",
+            "c.relname",
+            "'sequence'::text",
+            "c.relkind='S' AND n.nspname NOT IN ('pg_catalog','information_schema') AND n.nspname NOT LIKE 'pg_toast%' AND pg_catalog.has_schema_privilege(n.oid,'USAGE') AND CASE WHEN c.relkind='S' THEN pg_catalog.has_sequence_privilege(c.oid,'USAGE,SELECT,UPDATE') ELSE false END",
+            r#"pg_catalog.jsonb_build_object(
+                'owner',pg_catalog.pg_get_userbyid(c.relowner),'type',pg_catalog.format_type(s.seqtypid,NULL),
+                'start',s.seqstart::text,'minimum',s.seqmin::text,'maximum',s.seqmax::text,
+                'increment',s.seqincrement::text,'cache',s.seqcache::text,'cycle',s.seqcycle,
+                'owned_by',(SELECT pg_catalog.format('%I.%I.%I',tn.nspname,tc.relname,a.attname) FROM pg_catalog.pg_depend d JOIN pg_catalog.pg_class tc ON tc.oid=d.refobjid JOIN pg_catalog.pg_namespace tn ON tn.oid=tc.relnamespace JOIN pg_catalog.pg_attribute a ON a.attrelid=tc.oid AND a.attnum=d.refobjsubid WHERE d.classid='pg_catalog.pg_class'::regclass AND d.objid=c.oid AND d.refclassid='pg_catalog.pg_class'::regclass AND d.deptype IN ('a','i') LIMIT 1),
+                'comment',pg_catalog.obj_description(c.oid,'pg_class')
+            )"#,
+        ),
+        CatalogKind::Users | CatalogKind::Roles => (
+            "pg_catalog.pg_roles r",
+            "r.oid",
+            "''::text",
+            "r.rolname",
+            "CASE WHEN r.rolcanlogin THEN 'user / login role' ELSE 'role' END",
+            if kind == CatalogKind::Users {
+                "r.rolcanlogin"
+            } else {
+                "true"
+            },
+            r#"pg_catalog.jsonb_build_object(
+                'can_login',r.rolcanlogin,'superuser',r.rolsuper,'inherit',r.rolinherit,
+                'create_role',r.rolcreaterole,'create_database',r.rolcreatedb,
+                'replication',r.rolreplication,'bypass_rls',r.rolbypassrls,
+                'connection_limit',r.rolconnlimit,'valid_until',r.rolvaliduntil::text,
+                'member_of',(SELECT pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('role',p.rolname,'admin_option',m.admin_option) ORDER BY p.rolname) FROM pg_catalog.pg_auth_members m JOIN pg_catalog.pg_roles p ON p.oid=m.roleid WHERE m.member=r.oid),
+                'members',(SELECT pg_catalog.jsonb_agg(pg_catalog.jsonb_build_object('role',p.rolname,'admin_option',m.admin_option) ORDER BY p.rolname) FROM pg_catalog.pg_auth_members m JOIN pg_catalog.pg_roles p ON p.oid=m.member WHERE m.roleid=r.oid)
+            )"#,
+        ),
+    }
+}
+
+impl Postgres {
+    pub(super) async fn list_catalog(
+        &self,
+        kind: CatalogKind,
+        search: &str,
+        offset: u32,
+    ) -> Result<CatalogPage> {
+        if search.len() > 1024 || offset > 1_000_000 {
+            return Err(Error::new(
+                "Catalog search is limited to 1024 bytes and 1,000,000 rows of paging",
+            ));
+        }
+        let (from, id, schema, name, label, visible, _) = query_parts(kind);
+        let query = format!(
+            "SELECT {id},{schema}::text,{name}::text,{label} FROM {from} WHERE {visible} AND (CASE WHEN {schema}='' THEN {name} ELSE {schema} || '.' || {name} END) ILIKE $1 ESCAPE '!' ORDER BY {schema},{name},{id} LIMIT 101 OFFSET $2"
+        );
+        let pattern = format!(
+            "%{}%",
+            search
+                .replace('!', "!!")
+                .replace('%', "!%")
+                .replace('_', "!_")
+        );
+        let _guard = self.serial.lock().await;
+        let rows = self
+            .client
+            .query(&query, &[&pattern, &(offset as i64)])
+            .await
+            .map_err(err)?;
+        Ok(CatalogPage {
+            has_more: rows.len() > 100,
+            objects: rows
+                .into_iter()
+                .take(100)
+                .map(|row| CatalogObject {
+                    id: row.get::<_, u32>(0).to_string(),
+                    schema: row.get(1),
+                    name: row.get(2),
+                    kind: row.get(3),
+                })
+                .collect(),
+        })
+    }
+    pub(super) async fn inspect_catalog(
+        &self,
+        kind: CatalogKind,
+        id: &str,
+    ) -> Result<CatalogInspection> {
+        let oid = id
+            .parse::<u32>()
+            .map_err(|_| Error::new("Invalid catalog identifier"))?;
+        let (from, id, schema, name, label, visible, details) = query_parts(kind);
+        let sql = format!(
+            "SELECT pg_catalog.jsonb_pretty(pg_catalog.jsonb_build_object('schema',{schema},'name',{name},'kind',{label}) || {details}) AS details\nFROM {from}\nWHERE {visible} AND {id}={oid}::oid;"
+        );
+        let bounded = format!(
+            "SELECT pg_catalog.left(details,2097153) FROM ({}) AS inspection",
+            sql.trim_end_matches(';')
+        );
+        let _guard = self.serial.lock().await;
+        let row = self
+            .client
+            .query_opt(&bounded, &[])
+            .await
+            .map_err(err)?
+            .ok_or_else(|| Error::new("Object is no longer visible. Refresh the catalog."))?;
+        let details: String = row.get(0);
+        if details.len() > 2 * 1024 * 1024 {
+            return Err(Error::new("Catalog details exceed the 2 MiB viewer limit"));
+        }
+        Ok(CatalogInspection { sql, details })
+    }
+}
