diff --git a/crates/drivers/postgres/tests/catalog.rs b/crates/drivers/postgres/tests/catalog.rs
new file mode 100644
index 0000000..96083f5
--- /dev/null
+++ b/crates/drivers/postgres/tests/catalog.rs
@@ -0,0 +1,197 @@
+use klyndb_driver_api::{Batch, CatalogKind, Session, quote_identifier};
+use klyndb_postgres::Postgres;
+use std::sync::Arc;
+use tokio::sync::mpsc;
+use tokio_util::sync::CancellationToken;
+
+async fn query(driver: Arc<Postgres>, sql: String) -> Vec<Batch> {
+    let (tx, mut rx) = mpsc::channel(4);
+    let task =
+        tokio::spawn(async move { driver.execute(sql, tx, CancellationToken::new(), 100).await });
+    let mut result = Vec::new();
+    while let Some(batch) = rx.recv().await {
+        result.push(batch);
+    }
+    task.await.unwrap().unwrap();
+    result
+}
+
+#[tokio::test]
+#[ignore = "requires owned PostgreSQL fixture with CREATE ROLE and KLYNDB_TEST_POSTGRES_URL"]
+async fn postgres_catalog_paging_details_and_readonly_inspection() {
+    let url = std::env::var("KLYNDB_TEST_POSTGRES_URL")
+        .expect("Set the disposable PostgreSQL fixture URL");
+    let writer = Arc::new(Postgres::connect(&url, None, false, None).await.unwrap());
+    let reader = Arc::new(Postgres::connect(&url, None, true, None).await.unwrap());
+    let suffix = uuid::Uuid::new_v4().simple().to_string();
+    let schema = format!("klyndb catalog {suffix}");
+    let q = quote_identifier(&schema);
+    let login = format!("klyndb_login_{suffix}");
+    let role = format!("klyndb_role_{suffix}");
+    let setup = format!(
+        "CREATE SCHEMA {q}; CREATE TYPE {q}.status AS ENUM ('pending','<script>é</script>'); CREATE DOMAIN {q}.amount AS numeric(18,2) DEFAULT 0 NOT NULL CHECK (VALUE >= 0); CREATE TYPE {q}.pair AS (name text, amount {q}.amount); CREATE TYPE {q}.span AS RANGE (subtype=integer); CREATE SEQUENCE {q}.\"literal%_sequence\" START 9007199254740993; CREATE ROLE {login} LOGIN; CREATE ROLE {role} NOLOGIN; GRANT {role} TO {login};"
+    );
+    query(writer.clone(), setup).await;
+    let mut setup = String::new();
+    for i in 0..101 {
+        setup.push_str(&format!("CREATE TYPE {q}.item_{i:03} AS ENUM ('one');"));
+    }
+    query(writer.clone(), setup).await;
+    let first = reader
+        .catalog_objects(CatalogKind::Types, &schema, 0)
+        .await
+        .unwrap();
+    let second = reader
+        .catalog_objects(CatalogKind::Types, &schema, 100)
+        .await
+        .unwrap();
+    assert_eq!(first.objects.len(), 100);
+    assert!(first.has_more);
+    assert!(second.objects.len() >= 5);
+    assert!(!second.has_more);
+    assert!(
+        first
+            .objects
+            .iter()
+            .all(|a| second.objects.iter().all(|b| a.id != b.id))
+    );
+    let mut evidence = serde_json::json!({"first":first,"second":second,"inspections":{}});
+    for name in ["status", "amount", "pair", "span"] {
+        let page = reader
+            .catalog_objects(CatalogKind::Types, &format!("{schema}.{name}"), 0)
+            .await
+            .unwrap();
+        let object = page.objects.iter().find(|o| o.name == name).unwrap();
+        let inspected = reader
+            .catalog_inspect(CatalogKind::Types, &object.id)
+            .await
+            .unwrap();
+        let details: serde_json::Value = serde_json::from_str(&inspected.details).unwrap();
+        assert_eq!(details["name"], name);
+        match name {
+            "status" => assert_eq!(details["enum_labels"][1], "<script>é</script>"),
+            "amount" => {
+                assert_eq!(details["base_type"], "numeric(18,2)");
+                assert_eq!(details["not_null"], true);
+                assert!(
+                    details["constraints"][0]
+                        .as_str()
+                        .unwrap()
+                        .contains("CHECK")
+                );
+            }
+            "pair" => assert_eq!(details["attributes"][0]["name"], "name"),
+            "span" => assert_eq!(details["range_subtype"], "integer"),
+            _ => unreachable!(),
+        }
+        // The exported inspection query is executable through the ordinary read-only driver.
+        let replay = query(reader.clone(), inspected.sql.clone()).await;
+        assert!(
+            replay
+                .iter()
+                .any(|b| matches!(b,Batch::Rows(rows) if rows[0][0].text()==inspected.details))
+        );
+        evidence["inspections"][name] = serde_json::to_value(inspected).unwrap();
+    }
+    let seq = reader
+        .catalog_objects(
+            CatalogKind::Sequences,
+            &format!("{schema}.literal%_sequence"),
+            0,
+        )
+        .await
+        .unwrap();
+    assert_eq!(seq.objects.len(), 1);
+    let inspected = reader
+        .catalog_inspect(CatalogKind::Sequences, &seq.objects[0].id)
+        .await
+        .unwrap();
+    let details: serde_json::Value = serde_json::from_str(&inspected.details).unwrap();
+    assert_eq!(details["start"], "9007199254740993");
+    assert_eq!(details["maximum"], "9223372036854775807");
+    query(reader.clone(), inspected.sql.clone()).await;
+    let actual = query(
+        writer.clone(),
+        format!("SELECT last_value::text, is_called::text FROM {q}.\"literal%_sequence\";"),
+    )
+    .await;
+    assert!(actual.iter().any(|b|matches!(b,Batch::Rows(rows) if rows[0][0].text()=="9007199254740993" && rows[0][1].text()=="false")));
+    evidence["inspections"]["sequence"] = serde_json::to_value(inspected).unwrap();
+    for (kind, name) in [(CatalogKind::Users, &login), (CatalogKind::Roles, &role)] {
+        let page = reader.catalog_objects(kind, name, 0).await.unwrap();
+        assert_eq!(page.objects.len(), 1);
+        let inspected = reader
+            .catalog_inspect(kind, &page.objects[0].id)
+            .await
+            .unwrap();
+        let details: serde_json::Value = serde_json::from_str(&inspected.details).unwrap();
+        assert_eq!(details["can_login"], kind == CatalogKind::Users);
+        assert!(!inspected.details.contains("password"));
+        assert!(!inspected.sql.contains("rolpassword"));
+        if kind == CatalogKind::Users {
+            assert_eq!(details["member_of"][0]["role"], role);
+        } else {
+            assert_eq!(details["members"][0]["role"], login);
+        }
+        evidence["inspections"][if kind == CatalogKind::Users {
+            "user"
+        } else {
+            "role"
+        }] = serde_json::to_value(inspected).unwrap();
+        evidence[if kind == CatalogKind::Users {
+            "users"
+        } else {
+            "roles"
+        }] = serde_json::to_value(page).unwrap();
+    }
+    assert!(
+        reader
+            .catalog_objects(CatalogKind::Users, &role, 0)
+            .await
+            .unwrap()
+            .objects
+            .is_empty()
+    );
+    assert!(
+        reader
+            .catalog_objects(CatalogKind::Sequences, "%_sequence' OR true --", 0)
+            .await
+            .unwrap()
+            .objects
+            .is_empty()
+    );
+    assert!(
+        reader
+            .catalog_objects(CatalogKind::Types, &"a".repeat(1025), 0)
+            .await
+            .is_err()
+    );
+    assert!(
+        reader
+            .catalog_objects(CatalogKind::Types, "", 1_000_001)
+            .await
+            .is_err()
+    );
+    assert!(
+        reader
+            .catalog_inspect(CatalogKind::Types, "1 OR true")
+            .await
+            .is_err()
+    );
+    if let Ok(path) = std::env::var("KLYNDB_CATALOG_EVIDENCE") {
+        std::fs::write(path, serde_json::to_vec_pretty(&evidence).unwrap()).unwrap();
+    }
+    query(
+        writer.clone(),
+        format!("DROP SCHEMA {q} CASCADE; DROP ROLE {login}; DROP ROLE {role};"),
+    )
+    .await;
+    assert!(
+        reader
+            .catalog_inspect(CatalogKind::Sequences, &seq.objects[0].id)
+            .await
+            .is_err()
+    );
+    reader.disconnect().await.unwrap();
+    writer.disconnect().await.unwrap();
+}
